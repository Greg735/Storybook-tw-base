{#
 # Carousel.
 #
 # Variables:
 # - carousel_id: unique id.
 # - items: [{src, alt, caption, subcaption, html_content, lightbox_img}].
 # - indicators, controls: show the indicators / the previous and next buttons.
 # - autoplay: cycle through the slides (default true).
 # - carousel_height: fixed height in px (images are cropped).
 # - carousel_classes, carousel_attributes: additional classes and attributes.
 #}
{{ attach_library('storybook_tw_base/carousel') }}
{% for item in items %}
  {% if item.lightbox_img %}
    {{ attach_library('storybook_tw_base/image-lightbox') }}
  {% endif %}
  {% if item.caption or item.subcaption %}
    {{ attach_library('storybook_tw_base/animations') }}
  {% endif %}
{% endfor %}

{% set autoplay = autoplay|default(true) %}

<div id="{{ carousel_id }}" class="relative touch-pan-y{% if carousel_classes|length > 0 %} {{ carousel_classes|join(' ') }}{% endif %}" data-carousel{% if autoplay %} data-carousel-autoplay{% endif %}{% for attribute, value in carousel_attributes %} {{ attribute }}="{{ value|e }}"{% endfor %}>
  {% if indicators %}
    <ol class="absolute inset-x-0 bottom-0 z-2 mx-[15%] mb-4 flex list-none justify-center p-0">
      {% for i in 0..items|length - 1 %}
        <li class="mx-[3px] box-content h-[3px] w-[30px] flex-[0_1_auto] cursor-pointer border-x-0 border-y-[10px] border-transparent bg-white bg-clip-padding p-0 -indent-[999px] opacity-50 transition-opacity duration-600 ease-[ease] data-active:opacity-100 motion-reduce:transition-none" data-carousel-to="{{ i }}"{% if i == 0 %} data-active aria-current="true"{% endif %}></li>
      {% endfor %}
    </ol>
  {% endif %}

  <div class="relative w-full overflow-hidden after:clear-both after:block after:content-['']">
    {% for item in items %}
      {% set html_content = item.html_content %}
      <div class="relative float-left -me-[100%] hidden w-full backface-hidden transition-transform duration-600 ease-in-out data-active:block motion-reduce:transition-none" data-carousel-item{% if loop.first %} data-active{% endif %} {% if carousel_height %}style="height:{{ carousel_height }}px"{% endif %}>
        {% if item.lightbox_img %}
        <a href="{{ item.lightbox_img }}" class="glightbox">
        {% endif %}
        <img src="{{ item.src|e }}" class="block w-full{% if carousel_height %} h-full object-cover{% endif %}" alt="{{ item.alt|e }}">
        {% if item.caption or item.subcaption or html_content %}

          <div class="absolute inset-x-[15%] bottom-5 hidden py-5 text-center text-white md:block">

            {% block html_content %}
              {{ html_content }}
            {% endblock %}

            {% if item.caption %}
              <h5 data-cue="slideInUp" data-duration="1800">{{ item.caption }}</h5>
            {% endif %}
            {% if item.subcaption %}
              <p data-cue="slideInUp" data-duration="1800">{{ item.subcaption }}</p>
            {% endif %}

          </div>

        {% endif %}
        {% if item.lightbox_img %}
        </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  
  {% if controls %}
    {% set control_classes = 'absolute inset-y-0 z-1 flex w-[15%] items-center justify-center border-0 bg-transparent p-0 text-center text-white opacity-50 transition-opacity duration-150 ease-[ease] hover:opacity-90 focus:opacity-90 focus:outline-0 motion-reduce:transition-none' %}
    <button class="{{ control_classes }} left-0" type="button" aria-controls="{{ carousel_id }}" data-carousel-prev>
      <svg class="inline-block size-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
      <span class="sr-only">Previous</span>
    </button>
    <button class="{{ control_classes }} right-0" type="button" aria-controls="{{ carousel_id }}" data-carousel-next>
      <svg class="inline-block size-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/></svg>
      <span class="sr-only">Next</span>
    </button>
  {% endif %}
</div>
