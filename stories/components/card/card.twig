{#
 # Card: skeleton of the cards, with no style of its own. The variants
 # (card/default…) include it and give its classes and content.
 #
 # Variables:
 # - classes: array of classes.
 # - card_attributes: HTML attributes, {name: value}.
 # - content: the content (HTML when the caller passes markup).
 #}
<div{% if classes|length > 0 %} class="{{ classes|join(' ') }}"{% endif %}{% for attribute, value in card_attributes %} {{ attribute }}="{{ value|e }}"{% endfor %}>
  {{ content }}
</div>
