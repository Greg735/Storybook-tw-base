{% set font_size = "1.5em" %}

{% if icon_size_name == "small" %}
  {% set font_size = "1em" %}
{% elseif icon_size_name == "large" %}
  {% set font_size = "2em" %}
{% elseif icon_size_name == "x-large" %}
  {% set font_size = "2.5em" %}
{% endif %}

{% set sizes = {
  'sm': 'size-6',
  'md': 'size-8',
  'lg': 'size-12',
} %}

<div class="inline-flex items-center justify-center {{ sizes[icon_featured_size]|default('size-8') }} rounded text-bg-{{ color_theme }} mb-4{% if icon_featured_classes|length > 0 %} {{ icon_featured_classes|join(' ') }}{% endif %}" style="
    font-size: {{ font_size }};
"
{% for attribute, value in icon_featured_attributes %} {{ attribute }}="{{ value|e }}"{% endfor %}>
    {% include "@components/icon/icon.twig" with {
        'icon_name': icon_name
    } %}
</div>
